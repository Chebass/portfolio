---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";
import { ArrowLeft, ArrowUpRight, CodeXml } from "@lucide/astro";
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
const { project } = Astro.props;
---

<Layout title={`${project.title} — Sebastián Delgado`}>
  <article class="shell case-study">
    <a class="text-link" href="/#proyectos">
      <ArrowLeft size={16} aria-hidden="true" /> Todos los proyectos
    </a>
    <p class="eyebrow">
      {project.category}
      {project.template ? " / PLANTILLA EDITORIAL" : ""}
    </p>
    <h1>{project.title}</h1>
    <p class="case-lead">{project.summary}</p>
    {project.template && (
      <aside class="template-note">
        Este es un espacio de trabajo por completar. La portada es conceptual y
        no representa un proyecto real.
      </aside>
    )}
    {project.cover && (
      <img
        class="case-cover"
        src={project.cover}
        alt={`Vista principal de ${project.title}`}
        width="1440"
        height="900"
      />
    )}
    <div class="case-links">
      {project.demo && (
        <a
          class="button button-light"
          href={project.demo}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>Ver demo</span>
          <span class="button-icon">
            <ArrowUpRight size={18} aria-hidden="true" />
          </span>
        </a>
      )}
      {project.repository && (
        <a
          class="button"
          href={project.repository}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>Ver código</span>
          <span class="button-icon">
            <CodeXml size={18} aria-hidden="true" />
          </span>
        </a>
      )}
    </div>
    {project.technologies.length > 0 && (
      <p class="case-lead">{project.technologies.join(" · ")}</p>
    )}
    <div class="case-sections">
      {[
        ["01 / El problema", project.problem],
        ["02 / Mi contribución", project.contribution],
        ["03 / La solución", project.solution],
        ["04 / Resultados y aprendizajes", project.result],
      ].map(([title, body]) => (
        <section>
          <h2>{title}</h2>
          <p>{body}</p>
        </section>
      ))}
    </div>
    <section class="case-gallery">
      <h2>El proyecto en imágenes</h2>
      {project.screenshots.length ? (
        project.screenshots.map((image) => (
          <figure>
            <img
              src={image.src}
              alt={image.alt}
              loading="lazy"
              width="1440"
              height="900"
            />
            <figcaption>{image.caption}</figcaption>
          </figure>
        ))
      ) : (
        <p>
          Añadir una portada y entre dos y cuatro capturas: vista principal,
          flujo clave y detalle técnico. Una grabación local también puede
          mostrar cómo funciona.
        </p>
      )}
    </section>
    <a class="text-link" href="/#contacto">
      ¿Construimos algo juntos? <ArrowUpRight size={16} aria-hidden="true" />
    </a>
  </article>
</Layout>
