---
import Layout from "../layouts/Layout.astro";
import ProjectCards from "../components/ProjectCards.astro";
import TechStack from "../components/TechStack.astro";
import AboutSection from "../components/AboutSection.astro";
import { ArrowDownRight, ArrowDown, Sparkles } from "@lucide/astro";
import ContactLinks from "../components/ContactLinks.astro";
---

<Layout>
  <section class="hero" data-pointer-glow>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-content shell">
      <div class="hero-top">
        <span class="eyebrow">
          <i></i> SEBASTIAN DELGADO
        </span>
        <span class="index-label">PORTFOLIO</span>
      </div>
      <p class="hero-role reveal">AI Engineering / Full Stack Developer</p>
      <h1>
        Ideas que toman
        <br />
        <em>forma.</em> Código que
        <br />
        crea <span class="outline-text">posibilidades.</span>
      </h1>
      <div class="hero-bottom reveal">
        <p>
          De la inteligencia artificial a la experiencia digital.
          <br />
          Construyo soluciones que conectan ambas.
        </p>
        <a class="button button-light" href="#proyectos">
          <span>Explorar proyectos</span>
          <span class="button-icon">
            <ArrowDownRight size={18} stroke-width={1.75} aria-hidden="true" />
          </span>
        </a>
      </div>
      <div class="hero-foot">
        <span>PARA EQUIPOS CON IDEAS. PARA IDEAS CON FUTURO.</span>
        <a href="#sobre-mi">
          SCROLL PARA EXPLORAR <ArrowDown size={14} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <AboutSection />

  <section id="proyectos" class="shell section projects">
    <div class="section-heading reveal">
      <div>
        <span class="eyebrow">02 / TRABAJO SELECCIONADO</span>
        <h2>
          Detrás de cada interfaz,
          <br />
          <em>una solución.</em>
        </h2>
      </div>
      <p>
        Una mirada al proceso,
        <br />
        más allá de la pantalla.
      </p>
    </div>
    <ProjectCards />
  </section>

  <section id="stack" class="shell section">
    <div class="section-heading reveal">
      <div>
        <span class="eyebrow">03 / HERRAMIENTAS & CRITERIO</span>
        <h2>
          El stack cambia.
          <br />
          <em>La intención permanece.</em>
        </h2>
      </div>
      <p>
        La tecnología al servicio
        <br />
        de lo que queremos resolver.
      </p>
    </div>
    <TechStack />
  </section>

  <section id="contacto" class="contact shell section">
    <span class="eyebrow reveal">04 / EL SIGUIENTE PASO</span>
    <p class="contact-intro reveal">
      ¿Una idea, un proyecto o una oportunidad?
    </p>
    <h2 class="reveal">
      Hagamos que
      <br />
      <em>algo pase.</em>
      <span class="contact-star">
        <Sparkles size={120} stroke-width={0.8} aria-hidden="true" />
      </span>
    </h2>
    <ContactLinks />
  </section>
</Layout>
