---
import type { Technology } from "../data/technologies";
interface Props {
  technology: Technology;
  size?: number;
}
const { technology, size = 54 } = Astro.props;
const color =
  technology.kind === "brand"
    ? `#${technology.icon.hex}`
    : technology.kind === "concept"
      ? technology.color
      : "#D0EBF2";
function needsLightPlate(hex: string) {
  const channels = hex
    .match(/.{2}/g)!
    .map((channel) => parseInt(channel, 16) / 255);
  return (
    channels[0] * 0.2126 + channels[1] * 0.7152 + channels[2] * 0.0722 < 0.4
  );
}
const lightPlate =
  technology.kind === "brand"
    ? needsLightPlate(technology.icon.hex)
    : technology.kind === "image" && technology.lightPlate;
---

<span
  class:list={["tech-logo", { "light-plate": lightPlate }]}
  style={`--brand-color:${color};--logo-size:${size}px`}
  aria-hidden="true"
>
  {technology.kind === "brand" ? (
    <svg viewBox="0 0 24 24" fill="currentColor">
      <path d={technology.icon.path} />
    </svg>
  ) : technology.kind === "image" ? (
    <img src={technology.src} alt="" width="29" height="29" loading="lazy" />
  ) : (
    <technology.icon size={29} stroke-width={1.6} />
  )}
</span>

<style>
  .tech-logo {
    width: var(--logo-size);
    height: var(--logo-size);
    flex-shrink: 0;
    border: 1px solid #ffffff0c;
    border-radius: calc(var(--logo-size) * 0.28);
    display: inline-grid;
    place-items: center;
    background: #1a2225;
    box-shadow: 0 5px 10px #0003;
    transition:
      transform 0.3s,
      box-shadow 0.3s;
  }
  .tech-logo.light-plate {
    background: #e7ecec;
    border-color: #fff2;
  }
  .tech-logo :global(svg),
  .tech-logo img {
    display: block;
    width: calc(var(--logo-size) * 0.54);
    height: calc(var(--logo-size) * 0.54);
    color: var(--brand-color);
    object-fit: contain;
  }
  @media (prefers-reduced-motion: reduce) {
    .tech-logo {
      transition: none;
    }
  }
</style>
