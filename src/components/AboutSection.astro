---
import { Image } from "astro:assets";
import {
  ArrowUpRight,
  ArrowDownRight,
  MapPin,
  GraduationCap,
  Scan,
  X,
  Earth,
  PanelsTopLeft,
  BrainCircuit,
  Smartphone,
} from "@lucide/astro";
import portrait from "../assets/about/sebastian-delgado.jpg";
import diploma from "../assets/about/titulo-universitario.jpg";

const services = [
  {
    name: "Un sitio que hable por tu negocio.",
    category: "SITIOS WEB",
    icon: Earth,
    description:
      "Sitios estáticos o interactivos, landing pages y catálogos para presentar lo que haces y conectar con tus clientes.",
  },
  {
    name: "Tu operación, en una aplicación.",
    category: "APLICACIONES WEB",
    icon: PanelsTopLeft,
    description:
      "Herramientas a medida para gestionar inventario, personal, actividades y procesos de tu negocio desde un mismo lugar.",
  },
  {
    name: "Inteligencia donde sí aporta.",
    category: "IA & INTEGRACIONES",
    icon: BrainCircuit,
    description:
      "Asistentes, consultas sobre tus documentos y automatizaciones conectadas a tus sistemas, según lo que tu negocio necesite resolver.",
  },
  {
    name: "Tu idea, también en el bolsillo.",
    category: "APLICACIONES MÓVILES",
    icon: Smartphone,
    description:
      "Aplicaciones móviles para acercar tus servicios a tus clientes o llevar las herramientas de tu equipo a donde trabaja.",
  },
];
---

<section
  id="sobre-mi"
  class="about-editorial shell section"
  aria-labelledby="about-heading"
>
  <div class="about-section-line reveal">
    <span class="eyebrow">01 / LA PERSONA DETRÁS DEL CÓDIGO</span>
    <span class="about-location">
      <MapPin size={13} aria-hidden="true" /> LIMA, PERÚ
    </span>
  </div>

  <div class="about-intro-grid">
    <div class="about-visual-column">
      <figure class="about-portrait reveal">
        <div class="portrait-window">
          <Image
            src={portrait}
            alt="Sebastian Delgado en una calle de piedra, entre edificios de sillar."
            widths={[480, 800, 1200]}
            width={1200}
            sizes="(max-width: 900px) 90vw, 38vw"
            format="webp"
            quality={85}
            loading="lazy"
            class="about-portrait-image"
          />
          <div class="portrait-shade" aria-hidden="true"></div>
          <figcaption>
            <span>UN POCO MÁS DE.</span>
            <span class="portrait-signature">Sebastian Delgado</span>
          </figcaption>
        </div>
        <span class="portrait-side-note" aria-hidden="true">
          PERSONA / INGENIERO / CREADOR
        </span>
      </figure>

      <a
        class="academic-card reveal"
        href={diploma.src}
        data-diploma-open
        aria-haspopup="dialog"
        aria-controls="degree-dialog"
        aria-label="Ver título profesional de Ingeniero de Software de Sebastian Delgado"
      >
        <span class="degree-thumbnail">
          <Image src={diploma} alt="" width={88} format="webp" loading="lazy" />
          <span>
            <Scan size={17} aria-hidden="true" />
          </span>
        </span>
        <span class="degree-copy">
          <span class="degree-kicker">
            <GraduationCap size={14} aria-hidden="true" /> FORMACIÓN
          </span>
          <strong>Ingeniero de Software</strong>
          <span>Universidad Peruana de Ciencias Aplicadas</span>
          <span class="degree-year">
            BACHILLER · 2024
            <br />
            TÍTULO PROFESIONAL · 2026
          </span>
        </span>
        <ArrowUpRight class="degree-arrow" size={19} aria-hidden="true" />
      </a>
    </div>

    <div class="about-story">
      <p class="about-introduction reveal">Hola, soy Sebastian.</p>
      <h2 id="about-heading" class="reveal">
        Curioso por
        <br />
        naturaleza.
        <br />
        <em>
          Ingeniero por
          <br />
          convicción.
        </em>
      </h2>
      <div class="about-bio reveal">
        <span class="editorial-margin-label" aria-hidden="true">
          SOBRE MÍ
        </span>
        <p>
          Soy ingeniero de software, con más de tres años de experiencia como
          desarrollador. Me gusta conectar ideas, personas y tecnología;
          entender cómo funcionan las cosas y encontrar una forma más útil,
          clara y simple de hacerlas.
        </p>
      </div>
      <div class="interests-note reveal">
        <span class="small-label">LO QUE ME MUEVE</span>
        <p>
          Las buenas interfaces.
          <br />
          Los sistemas que <em>funcionan mejor.</em>
          <br />
          La IA que se convierte en algo útil.
        </p>
        <div class="interest-tags" aria-label="Intereses">
          <span>Desarrollo de producto</span>
          <span>Optimización</span>
          <span>Cloud & IA</span>
        </div>
      </div>
    </div>
  </div>

  <div class="experience-strip reveal">
    <div class="experience-heading">
      <span class="small-label">DE LA IDEA AL ENTORNO REAL</span>
      <h3>
        Interfaces, servicios
        <br />y conversaciones
        <br />
        <em>con inteligencia.</em>
      </h3>
    </div>
    <div class="experience-description">
      <p>
        En Laraigo he participado en el desarrollo de aplicaciones
        empresariales: interfaces con React y Next.js, servicios con NestJS,
        FastAPI y ASP.NET Core, y módulos conectados a PostgreSQL.
      </p>
      <p>
        También he trabajado con asistentes conversacionales, integración de
        proveedores LLM y arquitecturas RAG para consultar información en
        documentos. Me interesa cuidar el recorrido completo: lo que ve el
        usuario y lo que hace que todo funcione detrás.
      </p>
      <div class="experience-links">
        <a
          class="text-link"
          href="https://www.linkedin.com/in/sebastian-delgado-355907252/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Mi trayectoria en LinkedIn{" "}
          <ArrowUpRight size={16} aria-hidden="true" />
        </a>
        <a class="text-link" href="#proyectos">
          Explora el trabajo <ArrowDownRight size={16} aria-hidden="true" />
        </a>
      </div>
    </div>
    <span class="experience-vertical" aria-hidden="true">
      FULL STACK / AI ENGINEERING
    </span>
  </div>

  <div class="services-editorial">
    <div class="services-intro reveal">
      <span class="small-label">LO QUE PODEMOS CONSTRUIR</span>
      <h3>
        Tu negocio tiene
        <br />
        una idea.
        <br />
        <em>Démosle forma.</em>
      </h3>
      <p>
        Si necesitas un sitio web para tu negocio, una herramienta para tu
        equipo o quieres explorar qué puede aportar la IA, podemos empezar por
        entender tu necesidad y elegir juntos cómo resolverla.
      </p>
      <a
        class="button button-light"
        href="mailto:seb.delca.22@gmail.com?subject=Conversemos%20sobre%20mi%20proyecto"
      >
        <span>Cuéntame qué tienes en mente</span>
        <span class="button-icon">
          <ArrowUpRight size={18} aria-hidden="true" />
        </span>
      </a>
      <p class="team-invitation">
        ¿Estás formando un equipo? <a href="#contacto">También conversemos.</a>
      </p>
    </div>

    <div
      class="services-list"
      aria-label="Tipos de proyectos que puedo desarrollar"
    >
      {services.map((service, index) => (
        <article class="service-row reveal">
          <div class="service-marker">
            <span>0{index + 1}</span>
            <service.icon size={22} stroke-width={1.4} aria-hidden="true" />
          </div>
          <div>
            <span class="small-label">{service.category}</span>
            <h4>{service.name}</h4>
            <p>{service.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<dialog
  id="degree-dialog"
  class="degree-dialog"
  aria-labelledby="degree-dialog-heading"
>
  <div class="degree-dialog-header">
    <div>
      <span class="small-label">UPC / 2026</span>
      <h2 id="degree-dialog-heading">Título profesional</h2>
    </div>
    <button
      type="button"
      class="degree-close"
      data-diploma-close
      aria-label="Cerrar título universitario"
      autofocus
    >
      <X size={22} aria-hidden="true" />
    </button>
  </div>
  <div class="degree-document">
    <Image
      src={diploma}
      alt="Título profesional de Ingeniero de Software otorgado a Ronald Sebastian Delgado del Castillo por la Universidad Peruana de Ciencias Aplicadas, el 28 de agosto de 2026."
      width={1368}
      format="webp"
      quality={90}
      loading="lazy"
    />
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#degree-dialog");
  const trigger = document.querySelector<HTMLAnchorElement>(
    "[data-diploma-open]",
  );
  if (dialog && trigger) {
    let previousOverflow = "";
    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      previousOverflow = document.body.style.overflow;
      dialog.showModal();
      document.body.style.overflow = "hidden";
    });
    dialog
      .querySelector("[data-diploma-close]")
      ?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => {
      document.body.style.overflow = previousOverflow;
      trigger.focus({ preventScroll: true });
    });
  }
</script>

<style>
  .about-editorial {
    padding-bottom: 10px;
  }
  .about-section-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 30px;
    border-bottom: 1px solid var(--line);
  }
  .about-location {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 9px;
    letter-spacing: 1.6px;
    color: var(--muted);
    white-space: nowrap;
  }
  .about-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(50px, 7vw, 140px);
    padding: 60px 0 75px;
    align-items: center;
  }
  .about-visual-column {
    min-width: 0;
    max-width: 620px;
  }
  .about-portrait {
    margin: 0 20px 28px 0;
    position: relative;
  }
  .portrait-window {
    position: relative;
    overflow: hidden;
    border-radius: 180px 180px 20px 20px;
    aspect-ratio: 3 / 4;
    background: #252d30;
    isolation: isolate;
  }
  .portrait-window :global(.about-portrait-image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 70%;
  }
  .portrait-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(transparent 66%, #071014cc);
  }
  figcaption {
    position: absolute;
    bottom: 30px;
    left: 30px;
    right: 20px;
    color: white;
  }
  figcaption > span:first-child {
    display: block;
    font-size: 8px;
    letter-spacing: 2px;
    margin-bottom: 10px;
  }
  .portrait-signature {
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-size: clamp(30px, 3.3vw, 52px);
    letter-spacing: -0.8px;
  }
  .portrait-side-note {
    position: absolute;
    right: -28px;
    top: 50%;
    writing-mode: vertical-rl;
    font-size: 8px;
    letter-spacing: 2.3px;
    color: var(--muted);
  }
  .academic-card {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 19px;
    border: 1px solid #344348;
    border-radius: 14px;
    background: linear-gradient(130deg, #1a2428, #101617);
    box-shadow: inset 0 1px #ffffff09;
    transition:
      border-color 0.3s,
      transform 0.3s;
  }
  .degree-thumbnail {
    width: 62px;
    height: 83px;
    flex-shrink: 0;
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    background: #fff;
  }
  .degree-thumbnail :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .degree-thumbnail > span {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: #05101399;
    color: white;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .degree-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 7px;
    min-width: 0;
  }
  .degree-kicker {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 8px;
    letter-spacing: 1.4px;
    color: var(--accent);
  }
  .degree-copy strong {
    font-size: clamp(13px, 1.15vw, 18px);
    font-weight: 450;
  }
  .degree-copy > span:nth-last-child(2) {
    font-size: 10px;
    color: var(--muted);
    line-height: 1.5;
  }
  .degree-year {
    line-height: 1.8;
    font-size: 8px;
    letter-spacing: 0.8px;
    color: #96aeb6;
    margin-top: 3px;
  }
  .academic-card :global(.degree-arrow) {
    margin-left: auto;
    flex-shrink: 0;
    color: var(--accent);
  }
  .about-introduction {
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-size: clamp(25px, 2.5vw, 38px);
    color: var(--muted);
    margin: 0 0 20px;
  }
  .about-story h2 {
    margin: 0;
    font-size: clamp(48px, 5.3vw, 88px);
    line-height: 1.02;
    letter-spacing: -3.5px;
  }
  .about-story h2 em {
    font-size: 1.08em;
  }
  .about-bio {
    position: relative;
    margin: 40px 0 0 36px;
    border-left: 1px solid #435960;
    padding-left: 28px;
    max-width: 530px;
  }
  .about-bio p {
    font-size: 14px;
    line-height: 1.9;
    color: #c0c8ca;
    margin: 0;
  }
  .editorial-margin-label {
    position: absolute;
    left: -25px;
    top: 0;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 8px;
    letter-spacing: 2px;
    color: var(--muted);
  }
  .interests-note {
    padding-top: 35px;
    margin-left: auto;
    max-width: 440px;
  }
  .small-label {
    color: #99b4bd;
    font-size: 8px;
    letter-spacing: 1.8px;
    font-weight: 500;
  }
  .interests-note p {
    font-size: clamp(18px, 1.8vw, 26px);
    line-height: 1.5;
    letter-spacing: -0.6px;
    margin: 14px 0 20px;
  }
  .interests-note p em {
    font-family: "Instrument Serif", serif;
    font-size: 1.25em;
    color: var(--accent);
  }
  .interest-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .interest-tags span {
    border-bottom: 1px solid #354349;
    padding-bottom: 7px;
    font-size: 9px;
    color: var(--muted);
  }
  .interest-tags span + span::before {
    content: "/";
    margin: 0 8px 0 0;
    color: #69858d;
  }
  .experience-strip {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 70px;
    padding: 52px 55px 52px 0;
    border-block: 1px solid var(--line);
  }
  .experience-heading h3 {
    font-size: clamp(28px, 3.2vw, 48px);
    line-height: 1.13;
    font-weight: 400;
    letter-spacing: -1.5px;
    margin: 20px 0 0;
  }
  .experience-heading h3 em,
  .services-intro h3 em {
    font-family: "Instrument Serif", serif;
    font-weight: 400;
    color: var(--accent);
    font-size: 1.15em;
  }
  .experience-description p {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.9;
    max-width: 600px;
  }
  .experience-description p:first-child {
    margin-top: 0;
  }
  .experience-description .text-link {
    margin-top: 8px;
  }
  .experience-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
  }
  .experience-vertical {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    writing-mode: vertical-rl;
    color: #6e888f;
    font-size: 8px;
    letter-spacing: 2px;
  }
  .services-editorial {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: start;
    gap: clamp(45px, 7vw, 140px);
    padding-top: 85px;
  }
  .services-intro h3 {
    font-size: clamp(36px, 4vw, 64px);
    font-weight: 400;
    line-height: 1.07;
    letter-spacing: -2px;
    margin: 25px 0;
  }
  .services-intro > p {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.9;
    max-width: 430px;
  }
  .services-intro .button {
    margin-top: 20px;
    font-size: 11px;
    gap: 20px;
  }
  .services-intro .team-invitation {
    font-size: 10px;
    margin-top: 22px;
  }
  .team-invitation a {
    color: var(--accent);
    border-bottom: 1px solid #536c74;
    padding-bottom: 3px;
  }
  .service-row {
    display: grid;
    grid-template-columns: 35px minmax(0, 1fr);
    gap: 22px;
    padding: 26px 0;
    border-top: 1px solid var(--line);
  }
  .service-row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .service-marker {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 3px;
    color: #9ebbc4;
  }
  .service-marker > span {
    font-size: 9px;
    letter-spacing: 1px;
  }
  .service-marker :global(svg) {
    transition: transform 0.3s;
  }
  .service-row h4 {
    font-size: clamp(18px, 1.7vw, 25px);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.7px;
    margin: 10px 0 12px;
  }
  .service-row p {
    font-size: 12px;
    line-height: 1.85;
    color: var(--muted);
    max-width: 520px;
    margin: 0;
  }
  .degree-dialog {
    width: min(760px, calc(100% - 32px));
    max-height: calc(100dvh - 40px);
    border: 1px solid #516b74;
    border-radius: 18px;
    overflow: visible;
    padding: 0;
    background: #101719;
    color: var(--text);
    box-shadow: 0 30px 100px #0009;
  }
  .degree-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .degree-dialog::backdrop {
    background: #030708d9;
    backdrop-filter: blur(12px);
  }
  .degree-dialog-header {
    position: relative;
    flex-shrink: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 24px;
    background: #101719;
    border-radius: 17px 17px 0 0;
    border-bottom: 1px solid #34474e;
  }
  .degree-dialog-header h2 {
    font-size: 22px;
    letter-spacing: -0.5px;
    margin: 8px 0 0;
  }
  .degree-close {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid #415c65;
    border-radius: 50%;
    background: #1c2a30;
    color: var(--accent);
    cursor: pointer;
    flex-shrink: 0;
  }
  .degree-document {
    min-height: 0;
    margin: 20px;
    border-radius: 5px;
    overflow: auto;
    overscroll-behavior: contain;
    background: white;
  }
  .degree-document :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (hover: hover) {
    .academic-card:hover {
      transform: translateY(-3px);
      border-color: #91b7c1;
    }
    .academic-card:hover .degree-thumbnail > span {
      opacity: 1;
    }
    .service-row:hover .service-marker :global(svg) {
      transform: translate(3px, -3px);
    }
  }
  @media (min-width: 1600px) {
    .about-intro-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
    .about-visual-column {
      margin-left: 3vw;
    }
    .about-story {
      max-width: 800px;
    }
  }
  @media (max-width: 1100px) {
    .about-intro-grid {
      gap: 45px;
    }
    .about-story h2 {
      font-size: 55px;
      letter-spacing: -2.5px;
    }
    .academic-card {
      gap: 12px;
      padding: 14px;
    }
    .degree-thumbnail {
      width: 50px;
      height: 70px;
    }
    .interests-note {
      margin-left: 36px;
    }
    .experience-strip {
      gap: 40px;
    }
    .services-editorial {
      gap: 45px;
    }
  }
  @media (max-width: 900px) {
    .about-intro-grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 30px;
      padding-top: 40px;
      align-items: start;
    }
    .about-story h2 {
      font-size: 46px;
    }
    .about-introduction {
      font-size: 28px;
    }
    .about-bio {
      margin-left: 20px;
      padding-left: 20px;
      margin-top: 26px;
    }
    .about-bio p {
      font-size: 12px;
    }
    .interests-note {
      margin-left: 20px;
      padding-top: 25px;
    }
    .interests-note p {
      font-size: 18px;
    }
    .portrait-window {
      border-radius: 130px 130px 16px 16px;
    }
    .academic-card {
      flex-wrap: wrap;
    }
    .degree-thumbnail {
      width: 45px;
      height: 64px;
    }
    .degree-copy {
      flex: 1;
    }
    .academic-card :global(.degree-arrow) {
      display: none;
    }
    .services-editorial {
      grid-template-columns: 1fr 1.2fr;
      gap: 35px;
    }
    .services-intro .button {
      gap: 10px;
      padding-left: 16px;
      font-size: 10px;
    }
    .service-row {
      gap: 12px;
